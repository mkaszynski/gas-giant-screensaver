+bool CRenderer::drawFailureHalo(const Vector2D& viewport, float lockOpacity) {
+    static const auto ENABLED      = g_pConfigManager->getValue<Hyprlang::INT>("general:failure_halo");
+    static const auto SIZE         = g_pConfigManager->getValue<Hyprlang::INT>("general:failure_halo_size");
+    static const auto OPACITY      = g_pConfigManager->getValue<Hyprlang::INT>("general:failure_halo_opacity");
+    static const auto TRANSITIONMS = g_pConfigManager->getValue<Hyprlang::INT>("general:failure_halo_transition_ms");
+
+    const bool target = *ENABLED && g_pAuth && g_pAuth->m_bDisplayFailText;
+    const auto now    = std::chrono::steady_clock::now();
+    if (target != failureHalo.target) {
+        failureHalo.target              = target;
+        failureHalo.startOpacity        = failureHalo.opacity;
+        failureHalo.transitionStartedAt = now;
+    }
+
+    const int   transitionMs  = std::clamp(static_cast<int>(*TRANSITIONMS), 0, MAX_FAILURE_HALO_TRANSITION_MS);
+    const float targetOpacity = target ? 1.F : 0.F;
+    bool        animating     = false;
+    if (transitionMs == 0) {
+        failureHalo.opacity = targetOpacity;
+    } else {
+        const float elapsed = std::chrono::duration<float, std::milli>(now - failureHalo.transitionStartedAt).count();
+        const float phase   = std::clamp(elapsed / static_cast<float>(transitionMs), 0.F, 1.F);
+        const float eased   = phase * phase * (3.F - 2.F * phase);
+        failureHalo.opacity = failureHalo.startOpacity + (targetOpacity - failureHalo.startOpacity) * eased;
+        animating           = phase < 1.F;
+    }
+
+    const int haloSize = std::clamp(static_cast<int>(*SIZE), 0, MAX_FAILURE_HALO_SIZE);
+    if (failureHalo.opacity <= 0.F || haloSize == 0)
+        return animating;
+
+    static const CGradientValueData HALO_COLOR{CHyprColor(0.9F, 0.015F, 0.005F, 1.F)};
+    const float configuredOpacity = std::clamp(static_cast<float>(*OPACITY) / 100.F, 0.F, 1.F);
+    const int   bandSize          = std::max(1, (haloSize + FAILURE_HALO_LAYERS - 1) / FAILURE_HALO_LAYERS);
+    for (int layer = 0; layer < FAILURE_HALO_LAYERS; ++layer) {
+        const int inset = layer * bandSize;
+        if (inset >= haloSize)
+            break;
+
+        const float falloff = 1.F - static_cast<float>(inset) / static_cast<float>(haloSize);
+        const float alpha   = configuredOpacity * failureHalo.opacity * lockOpacity * falloff * falloff;
+        const float width   = std::max(0.F, static_cast<float>(viewport.x) - 2.F * inset);
+        const float height  = std::max(0.F, static_cast<float>(viewport.y) - 2.F * inset);
+
+        renderBorder(CBox{inset, inset, width, height}, HALO_COLOR, bandSize, 0, alpha);
+    }
+
+    return animating;
 }
 
